config {
  type: "assertion",
  tags: ["initial", "incremental"],
  description: "SCD2 integrity of dim_customer. Returns one row per violation (an assertion passes when it returns nothing): every customer has exactly one current version; versions are contiguous (valid_to = next valid_from, no gaps, no overlaps); the first version starts in 1900 and the last one is open; valid_from < valid_to; keys are unique."
}

WITH v AS (
  SELECT
    customer_key, customer_id, valid_from, valid_to, is_current,
    LEAD(valid_from) OVER (PARTITION BY customer_id ORDER BY valid_from) AS next_from,
    ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY valid_from) AS rn,
    COUNT(*) OVER (PARTITION BY customer_key) AS key_count
  FROM ${ref("dim_customer")}
)
SELECT customer_id, 'not exactly one current version' AS problem
FROM v GROUP BY customer_id HAVING COUNTIF(is_current) != 1
UNION ALL
SELECT customer_id, 'gap or overlap between versions' FROM v WHERE next_from IS NOT NULL AND valid_to != next_from
UNION ALL
SELECT customer_id, 'last version is not open-ended' FROM v WHERE next_from IS NULL AND valid_to != ${constants.HIGH_DT}
UNION ALL
SELECT customer_id, 'is_current does not match valid_to' FROM v WHERE is_current != (valid_to = ${constants.HIGH_DT})
UNION ALL
SELECT customer_id, 'first version does not start in 1900' FROM v WHERE rn = 1 AND valid_from != ${constants.LOW_DT}
UNION ALL
SELECT customer_id, 'valid_from >= valid_to' FROM v WHERE valid_from >= valid_to
UNION ALL
SELECT customer_id, 'duplicate customer_key' FROM v WHERE key_count > 1
